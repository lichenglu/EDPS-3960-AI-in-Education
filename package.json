{
  "name": "the-next-move",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.9"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "start": "bun src/server/index.ts",
    "test": "bun test ./tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "bun scripts/browser-tests.ts",
    "check": "bun run format:check && bun run typecheck && bun run test && bun run build",
    "dev": "bun scripts/dev.ts",
    "format": "prettier --write src scripts tests package.json tsconfig.json vite.config.ts playwright.config.ts .prettierrc.json",
    "format:check": "prettier --check src scripts tests package.json tsconfig.json vite.config.ts playwright.config.ts .prettierrc.json"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@rc-component/tour": "2.4.1",
    "@react-three/fiber": "9.8.2",
    "animal-island-ui": "4.0.1",
    "naive-icons": "1.17.0",
    "p5": "2.3.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/bun": "1.4.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
